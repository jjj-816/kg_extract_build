# MySQL：保存实验、文档、切片、LLM 调用、实体、检索结果和三元组
KG_MYSQL_ENABLED=0
KG_MYSQL_HOST=127.0.0.1
KG_MYSQL_PORT=3306
KG_MYSQL_USER=root
KG_MYSQL_PASSWORD=123456
KG_MYSQL_DATABASE=kg_experiments
KG_MYSQL_CHARSET=utf8mb4
KG_MYSQL_AUTO_INIT=1

# Neo4j：图谱同步仅读取 MySQL 中有效 final 三元组
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Milvus：只保存 retrieval_sentence 向量，主键与 MySQL chunk_id 一致
KG_MILVUS_ENABLED=0
KG_MILVUS_URI=http://127.0.0.1:19530
KG_MILVUS_TOKEN=
KG_MILVUS_COLLECTION=kg_document_segments

# 实验标识；留空时自动生成 kg-run-YYYYMMDD-HHMMSS
KG_RUN_NAME=
KG_CODE_COMMIT=

# 可移植路径配置；相对路径会按启动命令的工作目录解析，推荐使用绝对路径
KG_DOCUMENT_FOLDER=
KG_PROCESSED_RECORD=
KG_SCHEMA_PATH=
KG_SCHEMA_EXAMPLE_PATH=
KG_TRIPLET_DEBUG_DIR=
KG_ENTITY_DEBUG_DIR=
KG_VECTOR_MODEL_PATH=

# 施工方案审核：原 Word 与解析证据块的受控存储；正式输入仅支持 docx/doc
KG_AUDIT_STORAGE_DIR=
KG_AUDIT_TASK_LIBRARY_PATH=
KG_AUDIT_MAX_FILE_MB=50

# 论文实验默认不复用旧文件缓存，确保每个 run_id 记录完整执行过程
KG_RESPECT_LEGACY_BREAKPOINT=0
KG_REUSE_ENTITY_CACHE=0
KG_REUSE_TRIPLET_CACHE=0

# 关系抽取：共享证据批量模式（论文基线可改为 single_entity）
KG_RELATION_STRATEGY=shared_context_batch
KG_RELATION_BATCH_MAX_ENTITIES=3
KG_RELATION_BATCH_MIN_OVERLAP=0.4
KG_RELATION_BATCH_MAX_CONTEXT_CHARS=8000

# 原有 LLM 配置
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
LLM_MODEL=glm-4.5-air

# LLM 提供商；可选 zhipu/deepseek/ollama/qwen/modelscope/huggingface/custom
LLM_PROVIDER=zhipu

# 默认关闭；仅在明确需要推理模式时设为 1
LLM_ENABLE_THINKING=0

# 按实际使用的平台填写；不要提交真实密钥
ZAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
MODELSCOPE_API_TOKEN=
HF_TOKEN=
